# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
.venv/
.env

# User data / Recordings (root-level macro files only; subdirs are source)
/*.json
recordings/

# System files
.DS_Store
Thumbs.db

# AppImage build outputs
build/
squashfs-root/

# Compiled binaries from experiments (must never ship in src/ or the AppImage)
*.o
*.so
.quarantine/experimental/libei/ei_send

# Untracked local screenshot cache (README uses assets/demo.gif)
assets/demo-v3.png

# Tool caches and coverage output (pytest/ruff run in the repo root)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# AI chat/session dumps left in the working tree while developing:
# they are not project files, and `git add -A` picks them up.
freebuff-chat-*.md
